#pragma once
// MakerPulse — instellingen. Kopieer dit bestand naar config.h en vul in.
// Daarna in Arduino IDE: sketch Uploaden. mp_types.h blijft naast dit bestand.

// --- verplicht ---
#define WIFI_SSID "JOUW_WIFI_NAAM"            // 2,4 GHz-netwerk (niet 5 GHz)
#define WIFI_PASSWORD "JOUW_WIFI_WACHTWOORD"  // WiFi-wachtwoord
#define MAKERWORLD_UID 0UL                    // getal uit makerworld.com/.../u/DITGETAL
#define MAKER_NAME "Maker"                    // naam bovenaan het scherm (kort)

// --- Telegram (leeg laten = geen berichten) ---
#define TELEGRAM_BOT_TOKEN ""                 // van @BotFather na /newbot
#define TELEGRAM_CHAT_ID ""                   // jouw chat-id (getal, vaak - of positief)

// --- scherm ---
#define POLL_INTERVAL_SEC 300                 // check elke 300 seconden (120 / 300 / 600 / 900)
#define CYD_INVERT 0                          // 1 = kleuren omkeren bij bleek/negatief beeld
#define CYD_ROTATION 1                        // 0=USB onder, 1=USB links, 2=USB boven, 3=USB rechts
#define CYD_PANEL_ST7789 0                    // 1 = nieuwere CYD met USB-C
#define CYD_OFFSET_ROTATION 2                 // USB-C: 0, micro-USB: 2
#define CYD_RGB_ORDER 0                       // USB-C: 1, micro-USB: 0

// --- Home Assistant / MQTT (leeg = uit) ---
#define MQTT_HOST ""                          // IP van Home Assistant, bv. 192.168.1.10
#define MQTT_PORT 1883
#define MQTT_USER ""
#define MQTT_PASS ""

// --- welke Telegram-meldingen ---
#define NOTIFY_DOWNLOADS 1
#define NOTIFY_LIKES 1
#define NOTIFY_PRINTS 1
#define NOTIFY_BOOSTS 1
#define NOTIFY_COLLECTIONS 1
#define NOTIFY_COMMENTS 1
